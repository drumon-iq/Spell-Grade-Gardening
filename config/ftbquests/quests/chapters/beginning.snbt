		{
			dependencies: ["45526045F2926948"]
			description: [
				"The modpack contains my favorite magic mods, like Botania, Hex Casting and Ars Nouveau, and is gated behind Botania progress, if you don't like Botania, redstone and vanilla/semi-vanilla farms you probably won't like this pack."
				""
				"There is no Applied Energetics, no pipes, no conduits, no single block do all machine, no machines in fact, but you can still automate resources with some magic."
			]
			disable_toast: true
			hide_until_deps_complete: false
